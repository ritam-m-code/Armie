<!-- Pick scene: SO-101 on a tabletop (the floor plane is the table surface), one placeholder object. -->
<mujoco model="armie_pick">
  <include file="so101/so101.xml"/>

  <option timestep="0.00166667"/>  <!-- 1/600 s: exactly 20 substeps per 30 fps control step -->

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="160" elevation="-25" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="2d" name="table" builtin="checker" rgb1="0.55 0.45 0.35" rgb2="0.5 0.4 0.3" width="300" height="300"/>
    <material name="table" texture="table" texuniform="true" texrepeat="8 8"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.3 -0.3 1.2" dir="-0.2 0.2 -1" directional="true"/>
    <geom name="table" type="plane" size="1 1 0.05" material="table"/>

    <!-- Front camera placement is a placeholder until the real camera pose is measured -->
    <body name="workspace" pos="0.22 0 0"/>
    <camera name="front" mode="targetbody" target="workspace" pos="0.45 -0.40 0.45" fovy="55"/>

    <!-- Placeholder until the object list is decided -->
    <body name="object" pos="0.25 0 0.015">
      <freejoint name="object"/>
      <geom name="object" type="box" size="0.015 0.015 0.015" rgba="0.8 0.1 0.1 1" mass="0.03" friction="1.5 0.01 0.001"/>
    </body>
  </worldbody>
</mujoco>
